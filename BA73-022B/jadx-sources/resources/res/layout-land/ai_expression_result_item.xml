<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.honeyboard.icecone.aiwriter.view.AiWriterTransitionEffectView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ai_expression_image_frame"
    android:tag="layout-land/ai_expression_result_item_0"
    android:background="@drawable/ai_expression_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">
    <FrameLayout
        android:id="@+id/ai_expression_item_image_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/ai_expression_item_edit_container"
        app:layout_constraintEnd_toStartOf="@+id/ai_expression_item_edit_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ai_expression_item_edit_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/ai_expression_generated_image"
            android:layout_marginVertical="@dimen/ai_expression_landscape_image_margin_vertical"
            android:screenReaderFocusable="true">
            <ImageView
                android:id="@+id/ai_expression_image_view"
                android:background="@drawable/ai_expression_sticker_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                app:layout_constraintBottom_toTopOf="@+id/ai_expression_watermark"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.samsung.android.honeyboard.icecone.aiexpression.view.AiExpressionWatermarkView
                android:layout_gravity="start|bottom"
                android:id="@+id/ai_expression_watermark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ai_expression_watermark_margin_start"
                app:layout_constraintBottom_toTopOf="@+id/ai_expression_disclaimer"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:gravity="center"
                android:id="@+id/ai_expression_disclaimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginHorizontal="6dp"
                android:screenReaderFocusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ai_sticker_disclaimer_text_style"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/ai_expression_item_edit_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ai_expression_item_image_frame"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ai_expression_item_attribute_frame"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ai_expression_landscape_result_item_attribute_frame_height"
            android:layout_marginVertical="@dimen/ai_expression_landscape_result_item_attribute_margin_vertical"
            app:layout_constraintBottom_toTopOf="@+id/ai_expression_view_change_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/ai_expression_item_style_icon_container"
                android:padding="@dimen/ai_expression_style_icon_outline_size"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/ai_expression_landscape_result_item_attribute_margin_horizontal"
                android:layout_marginEnd="@dimen/ai_expression_style_icon_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/ai_expression_item_edit_text_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/ai_expression_item_style_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/ai_expression_item_edit_text_container"
                android:background="@drawable/ai_expression_result_page_editor_background"
                android:layout_width="0dp"
                android:layout_height="@dimen/ai_expression_landscape_result_editor_height"
                android:layout_marginEnd="@dimen/ai_expression_landscape_result_item_attribute_margin_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ai_expression_item_style_icon_container"
                app:layout_constraintTop_toTopOf="parent">
                <com.samsung.android.honeyboard.icecone.aiexpression.view.AiExpressionEditText
                    android:id="@+id/ai_expression_item_edit_text"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="@integer/ai_expression_result_page_editor_max_lines"
                    android:maxLength="@integer/ai_expression_input_text_max_length"
                    android:layout_marginStart="@dimen/ai_expression_result_page_editor_margin_start"
                    android:layout_marginEnd="@dimen/ai_expression_result_page_editor_margin_end"
                    android:layout_marginVertical="@dimen/ai_expression_result_page_editor_margin_vertical"
                    style="@style/ai_expression_input_text_style"/>
            </FrameLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ai_expression_style_list_view"
                android:background="@drawable/ai_expression_container"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/ai_expression_view_change_layout"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ai_expression_generate_button_height"
            android:layout_marginBottom="@dimen/ai_expression_landscape_generate_button_margin_bottom"
            android:layout_marginEnd="@dimen/ai_expression_layout_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ai_expression_item_attribute_frame">
            <com.samsung.android.honeyboard.icecone.aiexpression.animation.AiExpressionEffectButtonView
                android:layout_gravity="center"
                android:id="@+id/ai_expression_generate_button_target"
                android:tag="binding_1"
                android:background="@drawable/ai_expression_gen_button_background"
                android:layout_width="@dimen/ai_expression_generate_button_width"
                android:layout_height="match_parent"
                android:contentDescription="@string/ai_writing_composer_generate"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/ai_expression_generate_button"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                style="@style/ai_expression_generate_button_text_style"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.samsung.android.honeyboard.icecone.aiwriter.view.AiWriterTransitionEffectView>
