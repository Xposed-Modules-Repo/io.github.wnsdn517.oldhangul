<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout-land/ai_expression_create_layout_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ai_expression_editor_frame"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/ai_expression_layout_margin_bottom"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/ai_expression_layout_margin_horizontal"
        android:layout_marginEnd="@dimen/ai_expression_interval_between_landscape_layout">
        <com.samsung.android.honeyboard.icecone.aiexpression.view.AiExpressionEditText
            android:scrollbarStyle="outsideOverlay"
            android:gravity="start|top"
            android:layout_gravity="center_vertical"
            android:id="@+id/ai_expression_editor"
            android:tag="binding_2"
            android:background="@android:color/transparent"
            android:paddingBottom="10dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/ai_expression_input_hint"
            android:maxLength="@integer/ai_expression_input_text_max_length"
            android:layout_marginStart="@dimen/ai_expression_input_inner_margin_start"
            android:layout_marginEnd="@dimen/ai_expression_input_inner_margin_end"
            android:layout_marginVertical="@dimen/ai_expression_input_inner_margin_vertical"
            style="@style/ai_expression_input_text_style">
            <requestFocus/>
        </com.samsung.android.honeyboard.icecone.aiexpression.view.AiExpressionEditText>
        <EditText
            android:id="@+id/ai_expression_fake_editor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ai_expression_disclaimer_text_color"
                android:ellipsize="end"
                android:gravity="start"
                android:layout_gravity="start|bottom"
                android:id="@+id/ai_expression_disclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ai_expression_input_limit_text_margin_bottom"
                android:text="@string/ai_expression_disclaimer_text"
                android:maxLines="1"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="@dimen/ai_expression_input_limit_text_margin_end"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/counter"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_max="241dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ai_expression_limit_text_color"
                android:layout_gravity="end|bottom"
                android:id="@+id/counter"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ai_expression_input_limit_text_margin_bottom"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/ai_expression_input_limit_text_margin_end"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/ai_expression_disclaimer"
                app:layout_constraintWidth_max="34dp"
                style="@style/base_sec_400"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ai_expression_layout_margin_bottom"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/ai_expression_interval_between_landscape_layout">
        <FrameLayout
            android:id="@+id/ai_expression_style_view_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ai_expression_style_view_height_with_selected_outline"
            app:layout_constraintBottom_toTopOf="@+id/ai_expression_view_change_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ai_expression_style_view"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </FrameLayout>
        <com.samsung.android.honeyboard.icecone.aiexpression.view.AiExpressionViewChangeLayout
            android:id="@+id/ai_expression_view_change_layout"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ai_expression_generate_button_height"
            android:layout_marginTop="@dimen/ai_expression_landscape_interval_between_style_with_generate_button"
            android:layout_marginEnd="@dimen/ai_expression_layout_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ai_expression_style_view_container">
            <com.samsung.android.honeyboard.icecone.aiexpression.animation.AiExpressionEffectButtonView
                android:layout_gravity="center"
                android:id="@+id/ai_expression_generate_button_target"
                android:tag="binding_5"
                android:background="@drawable/ai_expression_gen_button_background"
                android:layout_width="@dimen/ai_expression_generate_button_width"
                android:layout_height="match_parent"
                android:contentDescription="@string/ai_writing_composer_generate"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/ai_expression_generate_button"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                style="@style/ai_expression_generate_button_text_style"/>
        </com.samsung.android.honeyboard.icecone.aiexpression.view.AiExpressionViewChangeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
