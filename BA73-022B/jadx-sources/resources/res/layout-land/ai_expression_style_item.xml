<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:padding="@dimen/ai_expression_style_view_selected_item_outer_stroke_size"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:stateListAnimator="?attr/seslSmallTouchAnimator"
    android:clipToOutline="true">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/ai_expression_style_item_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/ai_expression_style_image"
            android:layout_width="@dimen/ai_sticker_style_view_item_width"
            android:layout_height="match_parent"
            android:foreground="@color/ai_expression_style_item_overlay_color"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/ai_expression_style_item_text_color"
            android:ellipsize="end"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/ai_expression_style_text"
            android:layout_width="@dimen/ai_sticker_style_view_item_width"
            android:layout_height="@dimen/ai_sticker_style_view_text_height"
            android:layout_marginBottom="@dimen/ai_expression_style_view_padding_bottom"
            android:maxLines="@integer/ai_expression_style_view_text_max_line"
            android:paddingHorizontal="@dimen/ai_expression_style_view_padding_horizontal"
            style="@style/ai_expression_style_view_item_text"/>
    </FrameLayout>
</FrameLayout>
