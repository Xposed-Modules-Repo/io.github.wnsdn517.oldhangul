<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/preview_background_stroke">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#ffcccccc"/>
        </shape>
    </item>
    <item
        android:id="@+id/preview_background"
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#fffcfcfc"/>
        </shape>
    </item>
    <item
        android:id="@+id/flick_8way_top_left"
        android:right="75dp"
        android:bottom="75dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="10dp"/>
            <solid android:color="#ffd3d3d3"/>
        </shape>
    </item>
    <item
        android:id="@+id/flick_8way_top_right"
        android:left="75dp"
        android:bottom="75dp">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="10dp"/>
            <solid android:color="#ffd3d3d3"/>
        </shape>
    </item>
</layer-list>
