<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:padding="2dp">
    <item
        android:id="@+id/selector_color"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <size
                android:height="18dp"
                android:width="18dp"/>
            <solid android:color="#8f94fb"/>
            <stroke
                android:width="2dp"
                android:color="#ffffff"/>
        </shape>
    </item>
</layer-list>
