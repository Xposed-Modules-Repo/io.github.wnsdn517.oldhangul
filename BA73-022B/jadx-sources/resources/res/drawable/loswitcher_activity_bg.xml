<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:id="@+id/loswitcher_activity_background_stroke">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp"/>
                    <solid android:color="@color/lo_switcher_bg_color"/>
                    <stroke
                        android:width="2dp"
                        android:color="#57a3ff"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:id="@+id/loswitcher_activity_background">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp"/>
                    <solid android:color="@color/lo_switcher_bg_color"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
