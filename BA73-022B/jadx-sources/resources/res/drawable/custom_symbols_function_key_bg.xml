<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/key_background_stroke">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="@color/function_key_background_stroke"/>
        </shape>
    </item>
    <item
        android:id="@+id/key_background"
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/function_key_background"/>
        </shape>
    </item>
</layer-list>
