<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/floating_inactive_bg"
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/floating_keyboard_corner_radius"/>
            <stroke
                android:width="@dimen/floating_keyboard_stroke_width"
                android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
