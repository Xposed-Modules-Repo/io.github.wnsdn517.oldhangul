<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/sesl_color_picker_used_color_item_list_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:id="@+id/sesl_last_used_color_slot"
        android:visibility="gone"
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sesl_eye_dropper"
        android:layout_width="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:layout_height="@dimen/sesl_color_picker_oneui_3_used_color_item_size"
        android:src="@drawable/sesl_eyedropper"
        android:scaleType="center"
        android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
</LinearLayout>
