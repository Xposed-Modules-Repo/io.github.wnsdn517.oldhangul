<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <com.samsung.android.honeyboard.beehive.view.BackspaceFloatingButton
        android:layout_gravity="end|bottom"
        android:layout_width="@dimen/backspace_floating_action_button_size"
        android:layout_height="@dimen/backspace_floating_action_button_size"
        android:layout_marginBottom="@dimen/backspace_floating_action_button_margin"
        android:src="@drawable/backspace_fab_icon"
        android:scaleType="center"
        android:tint="?attr/expression_backspace_tint"
        android:contentDescription="@string/string_backspace"
        android:layout_marginEnd="@dimen/backspace_floating_action_button_margin"
        android:backgroundTint="?attr/expression_backspace_background_tint"
        app:borderWidth="0dp"
        app:fabCustomSize="@dimen/backspace_floating_action_button_size"/>
</FrameLayout>
