<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RadioGroup
        android:id="@+id/selection_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true">
        <RadioButton
            android:textSize="14sp"
            android:textColor="@color/setting_content_text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/selection_radio_button_lasso"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:checked="true"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"/>
        <RadioButton
            android:textSize="14sp"
            android:textColor="@color/setting_content_text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/selection_radio_button_rect"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:checked="false"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"/>
    </RadioGroup>
    <RelativeLayout
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/selection_radio_ripple_button_view_1"
            android:layout_width="match_parent"
            android:layout_height="42dp"/>
        <RelativeLayout
            android:id="@+id/selection_radio_ripple_button_view_2"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="42dp"/>
    </RelativeLayout>
    <com.samsung.android.sdk.pen.setting.common.SpenSwitchView
        android:gravity="center_vertical"
        android:id="@+id/partially_selected_switch"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="4.5dp"
        android:layout_below="@+id/selection_radio_group"/>
</merge>
