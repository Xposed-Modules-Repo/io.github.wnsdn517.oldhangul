<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/size_seekbar_body"
    android:paddingBottom="6dp"
    android:layout_width="300dp"
    android:layout_height="49dp">
    <TextView
        android:textSize="13px"
        android:textColor="@color/setting_content_text_color"
        android:gravity="bottom"
        android:id="@+id/seek_bar_value"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"/>
    <ImageButton
        android:id="@+id/seek_bar_minus_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/minus"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_alignParentStart="true"
        style="@style/SettingImageButtonStyle"/>
    <ImageButton
        android:id="@+id/seek_bar_plus_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/plus"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_alignParentEnd="true"
        style="@style/SettingImageButtonStyle"/>
    <FrameLayout
        android:id="@+id/size_seekbar_layout"
        android:layout_width="204dp"
        android:layout_height="24dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_toStartOf="@+id/seek_bar_plus_button"
        android:layout_toEndOf="@+id/seek_bar_minus_button">
        <SeekBar
            android:layout_gravity="center"
            android:id="@+id/seek_bar"
            android:paddingTop="@dimen/seekbar_padding_top"
            android:paddingBottom="@dimen/seekbar_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:maxHeight="2dp"
            android:max="99"
            android:progressDrawable="@drawable/seek_bar_progress_bg"
            android:minHeight="2dp"
            android:thumb="@drawable/seek_bar_thumb_no_scale"
            android:paddingStart="@dimen/seekbar_padding_side"
            android:paddingEnd="@dimen/seekbar_padding_side"
            android:splitTrack="false"/>
    </FrameLayout>
</RelativeLayout>
