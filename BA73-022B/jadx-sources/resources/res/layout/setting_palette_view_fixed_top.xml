<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/indicator_area"
        android:layout_width="22dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/palette_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/indicator_area">
        <FrameLayout
            android:id="@+id/fixed_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <com.samsung.android.sdk.pen.setting.colorpalette.SpenViewFlipper
            android:id="@+id/pallete_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </LinearLayout>
</merge>
