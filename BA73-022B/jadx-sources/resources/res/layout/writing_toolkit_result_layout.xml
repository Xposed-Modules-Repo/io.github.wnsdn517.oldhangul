<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/writing_toolkit_result_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/writing_toolkit_result_container"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/writing_toolkit_result_continues_progress_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/writing_toolkit_result_continues_progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/writing_toolkit_continues_progress_margin_top"
        app:layout_constraintBottom_toTopOf="@+id/writing_toolkit_result_indicator_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/writing_toolkit_result_container"
        layout="@layout/writing_toolkit_result_continues_progress_layout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/writing_toolkit_result_indicator_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/writing_toolkit_result_continues_progress_container">
        <com.google.android.material.tabs.TabLayout
            android:gravity="center"
            android:id="@+id/writing_toolkit_result_indicator"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/writing_toolkit_result_indicator_container_height"
            app:tabBackground="@null"
            app:tabGravity="center"
            app:tabIconTint="@color/writing_toolkit_indicator_color_selector"
            app:tabMaxWidth="@dimen/writing_toolkit_result_indicator_max_width"
            app:tabRippleColor="@null"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
