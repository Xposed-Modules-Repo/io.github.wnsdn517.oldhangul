<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/ai_sticker_stickers">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/item_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"/>
    <CheckBox
        android:id="@+id/ai_expression_item_checkbox"
        android:background="@drawable/checkbox_selector"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/ai_expression_deletable_item_checkbox_size"
        android:layout_height="@dimen/ai_expression_deletable_item_checkbox_size"
        android:layout_marginTop="@dimen/ai_expression_deletable_item_checkbox_margin"
        android:layout_marginStart="@dimen/ai_expression_deletable_item_checkbox_margin"
        android:buttonTint="@color/ai_expression_checkbox_tint_color"/>
</FrameLayout>
