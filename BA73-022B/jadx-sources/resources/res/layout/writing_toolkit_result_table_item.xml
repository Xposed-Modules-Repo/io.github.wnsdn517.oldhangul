<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/writing_toolkit_result_table_item_container"
    android:tag="layout/writing_toolkit_result_table_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/writing_toolkit_result_no_indicator_container_bottom_margin"
    android:layoutDirection="locale"
    android:layout_marginHorizontal="@dimen/writing_toolkit_result_item_container_margin_horizontal"
    android:clipToOutline="true">
    <com.samsung.android.writingtoolkit.view.WritingToolkitTableWebView
        android:id="@+id/writing_toolkit_table_result_capture"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cursorVisible="false"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/writing_toolkit_table_result_holder"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.samsung.android.writingtoolkit.view.WritingToolkitTableWebView
            android:id="@+id/writing_toolkit_table_result_display"
            android:focusable="false"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:cursorVisible="false"
            android:clipToOutline="true"
            app:layout_constraintBottom_toTopOf="@+id/writing_toolkit_result_action_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/writing_toolkit_result_action_layout"
            layout="@layout/writing_toolkit_result_action_layout"/>
        <include
            android:id="@+id/writing_toolkit_result_scrollbar_layout"
            layout="@layout/writing_toolkit_result_scrollbar_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
