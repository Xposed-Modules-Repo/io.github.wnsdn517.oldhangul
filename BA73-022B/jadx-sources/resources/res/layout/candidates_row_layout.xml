<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/candidate_row_view"
    android:tag="layout/candidates_row_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/candidate_text_color"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/candidate_row_component"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@dimen/candidate_expand_japanese_component_layout_width"
            android:textAlignment="center"/>
        <View
            android:id="@+id/candidate_row_component_divider_vertical"
            android:background="#e4e4e7"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidate_row_items"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@dimen/candidate_expand_japanese_items_layout_width"/>
    </LinearLayout>
    <View
        android:id="@+id/candidate_row_component_divider_bottom"
        android:background="#e4e4e7"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
