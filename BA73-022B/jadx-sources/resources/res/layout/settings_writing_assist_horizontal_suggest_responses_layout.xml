<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/app_theme_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/suggested_replies_img"
        android:background="@drawable/settings_writing_assist_image_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/settings_writing_assist_description_image_height"
        android:src="@drawable/img_suggested_replies_mobile_watch"
        android:scaleType="centerCrop"
        android:layout_weight="1"
        android:layout_marginVertical="@dimen/settings_suggest_responses_vertical_margin"
        android:clipToOutline="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginVertical="@dimen/settings_suggest_responses_vertical_margin"
        android:paddingHorizontal="@dimen/settings_writing_assist_padding_horizontal">
        <TextView
            android:textColor="@color/basic_interaction_description_text_color"
            android:id="@+id/suggested_replies_main_description_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_writing_assist_suggest_responses_help_else"
            style="@style/settings_main_description"/>
        <TextView
            android:textColor="@color/basic_interaction_description_text_color"
            android:id="@+id/suggested_replies_main_description_textview_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_writing_assist_suggest_responses_help_msg"
            android:layout_marginVertical="@dimen/settings_writing_assist_padding_vertical"
            style="@style/settings_main_description"/>
        <TextView
            android:textColor="@color/basic_interaction_description_text_color"
            android:id="@+id/chat_assist_privacy_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_writing_assist_suggest_responses_user_check"
            android:layout_marginVertical="@dimen/settings_writing_assist_padding_vertical"
            style="@style/settings_main_description"/>
    </LinearLayout>
</LinearLayout>
