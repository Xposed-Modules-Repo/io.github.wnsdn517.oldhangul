<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.samsung.android.sdk.pen.setting.remover.SpenRemoverLayout
        android:id="@+id/setting_remover_body_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <View
        android:id="@+id/space_view"
        android:focusable="false"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="22dp"/>
    <View
        android:id="@+id/remover_body_erase_all_divider"
        android:background="@drawable/spen_color_picker_recent_used_color_divider_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:id="@+id/remover_body_erase_all"
        android:background="@drawable/setting_eraser_all_button_ripple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="11dp"
        android:layout_marginStart="0px"
        android:layout_marginEnd="0px">
        <com.samsung.android.sdk.pen.setting.common.SpenShowButtonShapeText
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/remover_body_erase_all_text"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:minHeight="36dp"
            android:text="@string/pen_string_eraser_all_handwriting"
            android:includeFontPadding="false"
            android:layout_centerInParent="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </RelativeLayout>
</LinearLayout>
