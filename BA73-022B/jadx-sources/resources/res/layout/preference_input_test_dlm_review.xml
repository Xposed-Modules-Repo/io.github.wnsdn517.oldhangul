<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/list_left_margin"
    android:paddingEnd="@dimen/list_right_margin">
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#d32f2f"
        android:id="@+id/input_test_export_name_warning_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_input_test_export_name_required"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textStyle="bold"
        android:id="@+id/input_test_dlm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:id="@+id/input_test_dlm_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/input_test_dlm_open_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_input_test_dlm_open_button"
            android:maxLines="2"/>
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/input_test_dlm_without_dlm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_input_test_dlm_without_dlm_button"
            android:maxLines="2"/>
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/input_test_dlm_next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_input_test_dlm_next_button"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
