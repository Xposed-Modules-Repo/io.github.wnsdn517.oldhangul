<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/moakey_scroll_view"
    android:background="@color/app_theme_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/action_bar"/>
            <TextView
                android:textSize="@dimen/preference_settings_summary_text_size"
                android:gravity="center_vertical"
                android:id="@+id/moakey_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/moakey_swipe_angle_description"
                style="@style/basic_interaction_description"/>
            <FrameLayout
                android:id="@+id/moakey_drag_angle_view_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/moakey_setting_center_angle_text_size"
                    android:textColor="@color/moakey_setting_focused_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/angle_text_view"
                    android:background="@drawable/moakey_inner_angle_circle_bg"
                    android:layout_width="@dimen/moakey_setting_center_angle_view_size"
                    android:layout_height="@dimen/moakey_setting_center_angle_view_size"/>
            </FrameLayout>
            <Button
                android:textSize="@dimen/moakey_setting_reset_button_text_size"
                android:layout_gravity="center_horizontal"
                android:id="@+id/moa_dragconf_reset_button"
                android:layout_width="216dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="@string/reset"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.google.android.material.oneui.dividerbuttonlayout.DividerButtonLayout
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/divider_button_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/settings_bottom_navigation_padding"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
