<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.honeyboard.textboard.friends.emoticon.view.bubble.EmoticonBubbleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/rp_color_black"
        android:gravity="center"
        android:id="@+id/emoticon_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/emoticon_font_auto_size_granularity"
        android:autoSizeMinTextSize="@dimen/emoticon_font_auto_size_min"
        android:layout_marginHorizontal="4dp"
        android:autoSizeMaxTextSize="@dimen/emoticon_font_auto_size_max"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/emoticon_image_view"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="yes"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.samsung.android.honeyboard.textboard.friends.emoticon.view.bubble.EmoticonBubbleView>
