<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/permissions_for_app_tv"
                android:text="@string/permission_for_app"
                style="@style/DialogTextTitleStyle"/>
            <TextView
                android:id="@+id/optional_permissions"
                android:layout_marginBottom="0dp"
                android:text="@string/optional_permissions"
                style="@style/DialogTextStyleDesc"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/use_network_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <CheckBox
                    android:id="@+id/use_network_checkbox"
                    style="@style/DialogCheckBoxStyle"/>
                <TextView
                    android:text="@string/use_network_connections_including_hwr_service"
                    style="@style/DialogTextCheckboxTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <CheckBox
                    android:id="@+id/link_to_contacts_checkbox"
                    style="@style/DialogCheckBoxStyle"/>
                <TextView
                    android:text="@string/setting_link_to_contacts_title"
                    style="@style/DialogTextCheckboxTextStyle"/>
            </LinearLayout>
            <com.samsung.android.honeyboard.resourcepack.view.DottedLineView
                android:id="@+id/permission_dialog_dotted_line_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rp_dialog_dotted_line_margin_top"
                android:layout_marginStart="@dimen/rp_dialog_margin_horizontal"
                android:layout_marginEnd="@dimen/rp_dialog_margin_horizontal"/>
            <CheckBox
                android:id="@+id/permission_select_all_checkbox"
                android:visibility="gone"
                android:layout_marginTop="@dimen/rp_dialog_dotted_line_margin_top"
                android:layout_marginBottom="@dimen/rp_dialog_dotted_line_margin_top"
                android:text="@string/all"
                android:paddingEnd="@dimen/rp_dialog_checkbox_padding_end"
                style="@style/DialogCheckBoxStyle"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
