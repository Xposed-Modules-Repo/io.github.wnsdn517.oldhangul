<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="?attr/listChoiceBackgroundIndicator"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
    <FrameLayout
        android:gravity="start|center_vertical"
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/preference_spacebar_row_style_icon_frame_minwidth"
        android:paddingEnd="@dimen/sesl_list_image_end_padding">
        <androidx.preference.internal.PreferenceImageView
            android:layout_gravity="center"
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:maxHeight="@dimen/sesl_preference_item_icon_size"
            app:maxWidth="@dimen/sesl_preference_item_icon_size"/>
    </FrameLayout>
    <LinearLayout
        android:paddingTop="@dimen/preference_spacebar_row_style_preference_padding_top"
        android:paddingBottom="@dimen/preference_spacebar_row_style_preference_padding_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceListItem"
                android:ellipsize="end"
                android:id="@android:id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="5"
                android:layout_weight="1"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/sesl_menu_item_badge_text_size"
                android:textColor="@color/sesl_menu_badge_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/badge"
                android:background="@drawable/tw_noti_badge_mtrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/badge_left_margin"
                android:minWidth="@dimen/sesl_action_button_min_width"
                android:text="@string/badge_labs"
                android:fontFamily="sec-medium"
                android:backgroundTint="@color/toolbar_badge_color"
                android:paddingHorizontal="@dimen/sesl_control_padding"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@android:id/summary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="10"
            android:layout_below="@android:id/title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@android:id/title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="@dimen/preference_spacebar_row_style_widget_frame_minwidth"
        android:paddingStart="@dimen/sesl_list_widget_start_padding"/>
</LinearLayout>
