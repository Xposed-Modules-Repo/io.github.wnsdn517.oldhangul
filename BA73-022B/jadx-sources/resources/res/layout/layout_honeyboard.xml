<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.honeyboard.keyboard.view.HoneyBoardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/layout_honeyboard"
    android:tag="layout/layout_honeyboard_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/one_hand_left_stub"
        android:tag="binding_1"
        android:layout="@layout/layout_one_hand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_honeyboard_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="locale">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_ai_expression"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/layout_extension"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_base_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_translation"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:id="@+id/layout_spell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </FrameLayout>
        <ViewStub
            android:id="@+id/dex_title_bar_stub"
            android:layout="@layout/layout_floating_dex_title_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:id="@+id/layout_overlay_outer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/layout_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_gravity="bottom"
                        android:id="@+id/layout_honey_frame"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include layout="@layout/layout_base_frame"/>
                        <LinearLayout
                            android:gravity="bottom"
                            android:id="@+id/layout_expression_root_parent"
                            android:tag="binding_4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <include layout="@layout/layout_expression_frame"/>
                        </LinearLayout>
                    </FrameLayout>
                    <ViewStub
                        android:id="@+id/move_handler_stub"
                        android:layout="@layout/layout_move_handler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <ViewStub
        android:id="@+id/one_hand_right_stub"
        android:tag="binding_5"
        android:layout="@layout/layout_one_hand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.samsung.android.honeyboard.keyboard.view.HoneyBoardLayout>
