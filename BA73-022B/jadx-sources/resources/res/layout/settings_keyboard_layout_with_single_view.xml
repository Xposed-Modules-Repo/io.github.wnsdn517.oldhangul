<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="?attr/listChoiceBackgroundIndicator"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="@dimen/preference_switch_padding_right">
    <FrameLayout
        android:gravity="start|center_vertical"
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/preference_spacebar_row_style_icon_frame_minwidth"
        android:paddingEnd="@dimen/sesl_list_image_end_padding">
        <androidx.preference.internal.PreferenceImageView
            android:layout_gravity="center"
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:maxHeight="@dimen/sesl_preference_item_icon_size"
            app:maxWidth="@dimen/sesl_preference_item_icon_size"/>
    </FrameLayout>
    <LinearLayout
        android:paddingTop="@dimen/preference_spacebar_row_style_preference_padding_top"
        android:paddingBottom="@dimen/preference_spacebar_row_style_preference_padding_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_icons_padding_start">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/title_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/preference_spacebar_row_style_textview_comma_dot_size"
                    android:textStyle="normal"
                    android:textColor="@color/main_text_color_open_theme"
                    android:gravity="center"
                    android:id="@+id/title_prefix_text"
                    android:layout_width="@dimen/preference_spacebar_row_style_textview_width"
                    android:layout_height="@dimen/preference_spacebar_row_style_textview_height"
                    android:minHeight="@dimen/preference_spacebar_row_style_textview_minheight"
                    android:textAlignment="center"/>
            </LinearLayout>
            <TextView
                android:textAppearance="?attr/textAppearanceListItem"
                android:ellipsize="end"
                android:id="@android:id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="5"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/preference_spacebar_row_style_textview_margin_start"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@android:id/summary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="10"
            android:layout_below="@android:id/title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@android:id/title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="@dimen/preference_spacebar_row_style_widget_frame_minwidth"
        android:paddingHorizontal="@dimen/sesl_list_widget_start_padding"/>
</LinearLayout>
