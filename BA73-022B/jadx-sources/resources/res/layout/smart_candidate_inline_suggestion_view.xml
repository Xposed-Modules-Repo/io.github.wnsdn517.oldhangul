<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smart_candidate_constraint_layout"
    android:tag="layout/smart_candidate_inline_suggestion_view_0"
    android:padding="@dimen/now_nudge_item_padding"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.samsung.android.honeyboard.textboard.smartcandidate.view.SmartCandidateEffectView
        android:id="@+id/nudge_action_item_effect_view"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/smart_candidate_linear_layout"
        app:layout_constraintEnd_toEndOf="@+id/smart_candidate_linear_layout"
        app:layout_constraintStart_toStartOf="@+id/smart_candidate_linear_layout"
        app:layout_constraintTop_toTopOf="@+id/smart_candidate_linear_layout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/smart_candidate_linear_layout"
        android:tag="binding_2"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
