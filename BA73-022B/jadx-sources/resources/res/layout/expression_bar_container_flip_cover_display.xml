<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expression_container"
    android:tag="layout/expression_bar_container_flip_cover_display_0"
    android:background="?attr/expression_bar_background"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/header_layout_area_height_b5_cover"
    android:layoutDirection="locale">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/expression_start_margin_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/expression_margin_start_percent_flip_cover"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/expression_header_btn_layout"
        android:tag="binding_1"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        app:layout_constraintEnd_toStartOf="@+id/expression_content_start_guideline"
        app:layout_constraintStart_toStartOf="@+id/expression_start_margin_guideline">
        <ImageView
            android:id="@+id/expression_bar_keyboard_btn"
            android:background="?attr/expression_icon_recoil"
            android:layout_width="@dimen/expression_icon_size_b5"
            android:layout_height="@dimen/expression_icon_size_b5"
            android:src="@drawable/ic_keyboard"
            android:tint="?attr/expression_keyboard_back_button"
            android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
        <ImageView
            android:id="@+id/expression_bar_back_btn"
            android:background="?attr/expression_icon_recoil"
            android:layout_width="@dimen/expression_icon_size"
            android:layout_height="@dimen/expression_icon_size"
            android:src="@drawable/ic_expression_bar_back"
            android:tint="?attr/expression_enable_tint_color"
            android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/expression_content_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/expression_margin_end_percent_flip_cover"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/expression_divider"
        android:tag="binding_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/expression_divider_margin_start"
        app:layout_constraintStart_toEndOf="@+id/expression_content_start_guideline">
        <View
            android:gravity="center"
            android:tag="binding_3"
            android:background="?attr/expression_divider"
            android:layout_width="@dimen/expression_divider_width"
            android:layout_height="@dimen/expression_divider_height"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/expression_content"
        android:tag="binding_4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/expression_footer_btn_layout"
        app:layout_constraintStart_toEndOf="@+id/expression_divider">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/expression_label_container"
            android:tag="binding_5"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/expression_label_margin_start">
            <TextView
                android:textSize="@dimen/expression_label_size"
                android:textColor="?attr/expression_enable_tint_color"
                android:layout_gravity="center_vertical"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/expression_list_container"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.samsung.android.honeyboard.beehive.view.CarouselRecyclerView
                android:id="@+id/carousel_list"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/expression_category_container"
        android:tag="binding_8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/expression_label_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/expression_divider"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/expression_content_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/expression_content_left_percent_flip_cover"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/expression_footer_btn_layout"
        android:tag="binding_9"
        android:focusable="true"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:contentDescription="@string/expression_more_stickers"
        app:layout_constraintEnd_toEndOf="@+id/expression_end_margin_guideline"
        app:layout_constraintStart_toEndOf="@+id/expression_content_end_guideline">
        <ImageView
            android:id="@+id/expression_footer_btn"
            android:tag="binding_10"
            android:background="?attr/expression_icon_recoil"
            android:layout_width="@dimen/expression_icon_size_b5"
            android:layout_height="@dimen/expression_icon_size_b5"
            android:src="@drawable/ic_add"
            android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
        <ImageView
            android:id="@+id/expression_sticker_preview_btn"
            android:tag="binding_11"
            android:background="@drawable/sticker_item_image_white_bg"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="@dimen/candidate_sticker_size"
            android:layout_height="@dimen/candidate_sticker_size"
            android:soundEffectsEnabled="false"/>
        <ImageView
            android:id="@+id/expression_sticker_ftu_que"
            android:tag="binding_12"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="@dimen/toolbar_item_icon_size"
            android:layout_height="@dimen/toolbar_item_icon_size"
            android:soundEffectsEnabled="false"
            android:contentDescription="@string/accessibility_description_ftu_button"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/expression_end_margin_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/expression_content_right_percent_flip_cover"/>
</androidx.constraintlayout.widget.ConstraintLayout>
