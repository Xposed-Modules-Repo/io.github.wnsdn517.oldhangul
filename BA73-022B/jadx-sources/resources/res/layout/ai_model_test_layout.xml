<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"/>
    <TextView
        android:textSize="30dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/status_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Ready"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <Button
        android:id="@+id/import_tc_directory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Import Directory"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <Button
        android:id="@+id/import_tc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Import Test Case File"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <TextView
        android:textSize="20dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/file_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <CheckBox
        android:layout_gravity="center"
        android:id="@+id/same_file_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="save result to same file"/>
    <Spinner
        android:id="@+id/feature_spinner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:spinnerMode="dialog"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <Spinner
        android:id="@+id/tone_spinner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:spinnerMode="dialog"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <Spinner
        android:id="@+id/language_spinner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:spinnerMode="dialog"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
    <Button
        android:id="@+id/run_tc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Run Test"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"/>
</LinearLayout>
