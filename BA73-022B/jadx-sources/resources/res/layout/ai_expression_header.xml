<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/ai_expression_header_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ai_expression_header_height">
    <FrameLayout
        android:id="@+id/ai_expression_handler_layout"
        android:paddingTop="@dimen/ai_expression_handler_margin_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="@string/custom_action_bar_handle"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toTopOf="@+id/ai_expression_header_button_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ai_expression_handler"
            android:layout_width="@dimen/ai_expression_handler_width"
            android:layout_height="@dimen/ai_expression_handler_height"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ai_expression_header_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ai_expression_header_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="start"
            android:id="@+id/back_button"
            android:background="@drawable/ai_expression_icon_recoil_background"
            android:layout_width="@dimen/ai_expression_header_icon_size"
            android:layout_height="@dimen/ai_expression_header_icon_size"
            android:src="@drawable/ic_back_button"
            android:tint="@color/ai_expression_text_color"
            android:contentDescription="@string/string_navigate_up"
            android:stateListAnimator="?attr/seslSmallTouchAnimator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_sticker_styles"
            android:layout_marginStart="@dimen/ai_sticker_styles_layout_header_text_margin_start"
            app:layout_constraintStart_toEndOf="@+id/back_button"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ai_sticker_styles_layout_header_text_style"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageButton
                android:id="@+id/ai_expression_info_button"
                android:background="@drawable/writing_toolkit_icon_recoil"
                android:visibility="gone"
                android:layout_width="@dimen/writing_toolkit_icon_size"
                android:layout_height="@dimen/writing_toolkit_icon_size"
                android:src="@drawable/ic_info"
                android:tint="@color/writing_toolkit_icon_color"
                android:contentDescription="@string/writing_toolkit_disclaimer"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ai_expression_done"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/ai_expression_done_text_size"
                android:textColor="@color/ai_expression_text_color"
                android:id="@+id/ai_expression_done"
                android:tag="binding_3"
                android:background="@drawable/ai_expression_text_button_recoil_background"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ai_expression_header_icon_size"
                android:text="@string/ambi_editor_done"
                android:singleLine="true"
                android:fontFamily="sec"
                android:layout_marginEnd="@dimen/ai_expression_done_margin_horizontal"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"
                android:textFontWeight="@integer/ai_expression_done_font_weight"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
