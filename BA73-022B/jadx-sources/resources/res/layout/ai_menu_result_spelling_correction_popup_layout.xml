<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/spelling_correction_state_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ai_menu_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/spelling_correction_state_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_writer_original"
            android:fontFamily="sec"
            android:textFontWeight="600"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/spelling_correction_state_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ai_menu_spell_original"
            android:tint="@color/ai_menu_text_color"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="normal"
            android:textColor="@color/ai_menu_text_color"
            android:id="@+id/spelling_correction_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="test"
            android:fontFamily="sec"
            android:layout_marginEnd="4dp"
            android:textFontWeight="400"/>
    </ScrollView>
</LinearLayout>
