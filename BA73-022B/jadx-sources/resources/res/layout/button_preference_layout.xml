<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/button_and_symbol_text_size"
            android:textColor="@color/button_and_symbol_layout_apply_button_text"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/button"
            android:background="@drawable/button_and_symbol_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_and_symbol_layout_apply_button_height"
            android:minWidth="@dimen/button_and_symbol_layout_apply_button_width"
            android:minHeight="@dimen/button_and_symbol_layout_apply_button_minimum_height"
            android:text="@string/keyboard_themes_apply_button"
            android:layout_weight="3"
            android:backgroundTint="@color/button_and_symbol_layout_apply_button"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
