<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.honeyboard.textboard.bee.inputtype.InputTypeBeeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/change_input_type_layout_constraint"
    android:background="@color/toolbar_popup_dim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background_layer"
        android:background="@color/rp_textboard_keyboard_background_color_light"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/change_input_type_language_name"
        android:layout_width="@dimen/match_constraint"
        android:layout_height="@dimen/match_constraint"
        app:layout_constraintEnd_toEndOf="@+id/language_name_end_guide_line"
        app:layout_constraintStart_toStartOf="@+id/first_column_start_guide_line"
        app:layout_constraintTop_toTopOf="@+id/language_name_top_guide_line"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/language_name_end_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_language_name_end_guide_line"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/language_name_end_guide_line_land"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_language_name_end_guide_line_land"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/language_name_top_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_language_name_top_guide_line"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/language_name_top_guide_line_land"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_language_name_top_guide_line_land"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/first_row_top_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_first_row_top_guide_line"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/second_row_top_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
