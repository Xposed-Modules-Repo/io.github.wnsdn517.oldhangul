        android:id="@+id/first_row_top_guide_line_land"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_first_row_top_guide_line_land"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/second_row_top_guide_line_land"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/change_input_type_second_row_top_guide_line_land"/>
