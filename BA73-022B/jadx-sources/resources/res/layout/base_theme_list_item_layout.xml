<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/high_contrast_layout_margin_bottom">
    <FrameLayout
        android:id="@+id/theme_icon_container"
        android:layout_width="@dimen/keyboard_themes_icon_container_width"
        android:layout_height="@dimen/keyboard_themes_icon_container_height"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/theme_icon"
            android:background="@drawable/normal_key_background_image_open_theme"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="@dimen/keyboard_themes_icon_key_width"
            android:layout_height="@dimen/keyboard_themes_icon_key_height"/>
        <CheckBox
            android:id="@+id/checkbox_icon"
            android:background="@drawable/settings_checkbox_selector"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/keyboard_themes_select_image_width"
            android:layout_height="@dimen/keyboard_themes_select_image_height"/>
        <TextView
            android:textSize="@dimen/keyboard_themes_thumbnail_text_size"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/theme_text"
            android:layout_width="@dimen/keyboard_themes_icon_text_width"
            android:layout_height="@dimen/keyboard_themes_icon_text_height"/>
    </FrameLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/theme_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/high_contrast_theme_name_margin"
        android:layout_below="@+id/theme_icon_container"
        android:layout_centerHorizontal="true"
        style="@style/keyboard_theme_thumbnail_item_text"/>
</RelativeLayout>
