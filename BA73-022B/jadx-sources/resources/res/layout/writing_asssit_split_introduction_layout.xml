<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/ai_writer_split_introduction_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/writing_assist_intelligent_writing_horizontal_margin">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/writing_assist_intelligent_writing_description_text_size"
        android:textColor="?attr/writing_assist_split_introduction_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/ai_writer_split_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/writing_assist_tablet_and_fold_expand_intro"
        android:layout_marginHorizontal="19dp"
        android:paddingHorizontal="10dp"/>
</LinearLayout>
