<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:tag="layout/writing_toolkit_result_continues_progress_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/writing_toolkit_result_continues_progress"
        android:layout_width="@dimen/writing_toolkit_continues_progress_icon_size"
        android:layout_height="@dimen/writing_toolkit_continues_progress_icon_size"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/intelligence_progress"/>
    <TextView
        android:textSize="@dimen/writing_toolkit_progress_text_size"
        android:textColor="@color/writing_toolkit_progress_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/writing_toolkit_result_continues_progress_text"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:fontFamily="sec"
        android:layout_marginStart="@dimen/writing_toolkit_continues_progress_margin"
        android:textFontWeight="400"/>
    <ImageButton
        android:id="@+id/writing_toolkit_result_continues_progress_close_button"
        android:tag="binding_2"
        android:background="@drawable/writing_toolkit_close_button_bg"
        android:layout_width="@dimen/writing_toolkit_icon_size"
        android:layout_height="@dimen/writing_toolkit_icon_size"
        android:src="@drawable/ic_close"
        android:tint="@color/writing_toolkit_close_button_icon_color"
        android:contentDescription="@string/writing_toolkit_close"
        android:layout_marginStart="@dimen/writing_toolkit_continues_progress_margin"/>
</LinearLayout>
