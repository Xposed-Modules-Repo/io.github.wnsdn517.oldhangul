<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout"
    android:tag="layout/language_download_item_0"
    android:background="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeight">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_group"
        android:paddingTop="@dimen/language_list_preference_padding_top"
        android:paddingBottom="@dimen/language_list_preference_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="?android:attr/listPreferredItemHeightSmall"
        android:layout_centerInParent="true"
        android:layout_marginStart="?android:attr/listPreferredItemPaddingStart"
        android:layout_toStartOf="@+id/icon_group"
        android:layout_alignParentStart="true">
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:ellipsize="marquee"
            android:id="@+id/language_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:textDirection="locale"/>
        <TextView
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/textAppearanceListItemSecondary"/>
        <androidx.appcompat.widget.SeslProgressBar
            android:id="@+id/progress"
            android:paddingTop="@dimen/language_list_progressbar_topmargin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_marginEnd="@dimen/language_list_progressbar_rightmargin"
            style="@style/Widget.AppCompat.Light.ProgressBar.Horizontal"/>
    </LinearLayout>
    <TableLayout
        android:gravity="center_vertical"
        android:id="@+id/icon_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minHeight="?android:attr/listPreferredItemHeightSmall"
        android:shrinkColumns="*"
        android:layout_centerInParent="true"
        android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd"
        android:layout_alignParentEnd="true">
        <TableRow android:gravity="center_vertical">
            <ImageButton
                android:gravity="center"
                android:id="@+id/download"
                android:background="@drawable/manage_language_update_round_bg"
                android:layout_width="@dimen/language_list_download_button_size"
                android:layout_height="@dimen/language_list_download_button_size"
                android:src="@drawable/ic_download_arrow_down_to_line"
                android:soundEffectsEnabled="false"
                android:contentDescription="@string/input_language_download"/>
            <ImageButton
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/manage_language_cancel_round_bg"
                android:layout_width="@dimen/language_list_cancel_button_size"
                android:layout_height="@dimen/language_list_cancel_button_size"
                android:src="@drawable/ic_manage_language_cancel"
                android:contentDescription="@string/cancel"/>
            <Button
                android:textColor="@color/manage_language_update_button_text_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/update"
                android:background="@drawable/manage_language_update_round_bg"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/language_list_button_height"
                android:text="@string/update"
                android:contentDescription="@string/input_language_update"
                android:requiresFadingEdge="none"
                android:textAlignment="center"
                android:layout_marginEnd="@dimen/language_list_button_right_margin"
                android:paddingHorizontal="@dimen/language_list_update_button_padding"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/enable"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"/>
        </TableRow>
    </TableLayout>
</RelativeLayout>
