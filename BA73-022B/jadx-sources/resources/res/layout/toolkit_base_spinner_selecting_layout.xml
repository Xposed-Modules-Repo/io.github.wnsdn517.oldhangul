<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolkit_base_spinner_height"
    android:paddingHorizontal="@dimen/toolkit_base_spinner_horizontal_padding">
    <View
        android:id="@+id/toolkit_base_spinner_empty_space"
        android:layout_width="@dimen/toolkit_base_spinner_icon_size"
        android:layout_height="@dimen/toolkit_base_spinner_icon_size"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/toolkit_base_spinner_selecting_text_color"
        android:gravity="center"
        android:id="@+id/toolkit_base_spinner_selected_text"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolkit_base_spinner_height"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:fontFamily="sec"
        android:textAlignment="gravity"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/toolkit_base_spinner_text_granularity"
        android:autoSizeMinTextSize="@dimen/toolkit_base_spinner_text_min_size"
        android:layout_marginHorizontal="@dimen/toolkit_base_spinner_text_margin_horizontal"
        android:autoSizeMaxTextSize="@dimen/toolkit_base_spinner_text_max_size"
        android:textFontWeight="600"/>
    <ImageView
        android:layout_width="@dimen/toolkit_base_spinner_icon_size"
        android:layout_height="@dimen/toolkit_base_spinner_icon_size"
        android:src="@drawable/ic_spinner_dropdown_check"
        android:tint="@color/toolkit_base_spinner_selecting_arrow_color"
        android:importantForAccessibility="no"/>
</LinearLayout>
