<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/writing_composer_layout_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/writing_composer_bottom_sheet"
        android:background="@drawable/writing_toolkit_bottom_sheet_bg"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/writing_composer_header_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/writing_composer_content_container"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/writing_composer_transition_effect"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/writing_composer_bg_effect"
                    android:background="@drawable/writing_toolkit_bottom_sheet_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <View
                android:id="@+id/writing_composer_effect"
                android:background="@drawable/writing_toolkit_effect_transparent_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToOutline="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/writing_composer_header"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/writing_composer_header"/>
            <androidx.core.widget.NestedScrollView
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/writing_composer_body"
                android:scrollbars="vertical"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:paddingHorizontal="@dimen/writing_composer_body_padding_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/writing_composer_header"
                app:layout_constraintWidth_max="@dimen/writing_composer_body_max_width">
                <FrameLayout
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include
                        android:id="@+id/writing_composer_input_layout"
                        layout="@layout/writing_composer_input_layout"/>
                    <include
                        android:id="@+id/writing_composer_loading_layout"
                        layout="@layout/writing_composer_loading_layout"/>
                    <include
                        android:id="@+id/writing_composer_result_layout"
                        layout="@layout/writing_composer_result_layout"/>
                    <include
                        android:id="@+id/writing_composer_error_message_layout"
                        layout="@layout/writing_composer_error_message_layout"/>
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
