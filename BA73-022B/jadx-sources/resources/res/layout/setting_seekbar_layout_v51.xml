<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/seekbar_title_text_size"
        android:textColor="@color/setting_brush_pen_seekbar_text_color"
        android:gravity="start|top"
        android:id="@+id/seek_bar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:paddingStart="21dp"
        android:paddingEnd="21dp"/>
    <RelativeLayout
        android:id="@+id/seek_bar_body"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/seekbar_progress_text_size"
            android:textColor="@color/setting_brush_pen_seekbar_text_color"
            android:gravity="bottom"
            android:id="@+id/seek_bar_text"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:includeFontPadding="false"
            android:layout_centerHorizontal="true"/>
        <ImageButton
            android:id="@+id/seek_bar_minus_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/seek_bar_text"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentStart="true"
            style="@style/SettingImageButtonStyle"/>
        <ImageButton
            android:id="@+id/seek_bar_plus_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/seek_bar_text"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="14dp"
            android:layout_alignParentEnd="true"
            style="@style/SettingImageButtonStyle"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_below="@+id/seek_bar_text"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_toStartOf="@+id/seek_bar_plus_button"
            android:layout_toEndOf="@+id/seek_bar_minus_button">
            <SeekBar
                android:layout_gravity="center"
                android:id="@+id/seek_bar"
                android:background="@drawable/spen_ripple_effect_drawable"
                android:paddingTop="@dimen/seekbar_padding_top"
                android:paddingBottom="@dimen/seekbar_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/seek_bar_progress_bg"
                android:minHeight="2dp"
                android:thumb="@drawable/seek_bar_thumb_no_scale"
                android:paddingStart="@dimen/seekbar_padding_side"
                android:paddingEnd="@dimen/seekbar_padding_side"
                android:splitTrack="false"/>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>
