<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/writing_toolkit_activity_header_0"
    android:focusable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/writing_composer_header_height"
    android:paddingHorizontal="@dimen/writing_composer_header_padding_horizontal">
    <View
        android:layout_gravity="center"
        android:id="@+id/writing_toolkit_activity_handler"
        android:background="@drawable/writing_toolkit_handler"
        android:layout_width="@dimen/writing_toolkit_bottom_sheet_handler_width"
        android:layout_height="@dimen/writing_toolkit_bottom_sheet_handler_height"
        android:layout_marginTop="@dimen/writing_toolkit_bottom_sheet_handler_margin_top"
        android:contentDescription="@string/custom_action_bar_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/writing_toolkit_activity_back_button"
        android:src="@drawable/ic_toolkit_back"
        android:contentDescription="@string/writing_toolkit_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/WritingComposerHeaderIconStyle"/>
    <ImageView
        android:id="@+id/writing_toolkit_activity_header_title_icon"
        android:src="@drawable/ic_intelligence"
        app:layout_constraintStart_toEndOf="@+id/writing_toolkit_activity_back_button"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/WritingComposerHeaderTitleIconStyle"/>
    <TextView
        android:id="@+id/writing_toolkit_activity_header_title"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/writing_composer_header_title_margin_top"
        android:layout_marginStart="@dimen/writing_toolkit_header_title_margin_start"
        android:layout_marginEnd="@dimen/writing_toolkit_header_item_horizontal_gap"
        app:layout_constraintEnd_toStartOf="@+id/writing_toolkit_cancel"
        app:layout_constraintStart_toEndOf="@+id/writing_toolkit_activity_header_title_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        style="@style/WritingToolkitHeaderTitleStyle"/>
    <TextView
        android:id="@+id/writing_toolkit_cancel"
        android:text="@string/writing_toolkit_cancel"
        app:layout_constraintEnd_toStartOf="@+id/writing_toolkit_done"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/WritingComposerHeaderTextButtonStyle"/>
    <TextView
        android:id="@+id/writing_toolkit_done"
        android:text="@string/writing_toolkit_done"
        app:layout_constraintEnd_toStartOf="@+id/writing_toolkit_activity_info_button"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/WritingComposerHeaderTextButtonStyle"/>
    <ImageButton
        android:id="@+id/writing_toolkit_activity_info_button"
        android:src="@drawable/ic_info"
        android:contentDescription="@string/writing_toolkit_disclaimer"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/WritingComposerHeaderIconStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
