<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/writing_toolkit_result_item_root"
    android:tag="layout/writing_toolkit_result_item_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:clipToOutline="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/writing_toolkit_translate_language"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="@dimen/writing_toolkit_summary_translate_language_view_height"
        android:layout_marginTop="@dimen/writing_toolkit_summary_translate_spinner_margin_top"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:id="@+id/source_language"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/writing_toolkit_summary_translate_spinner_margin"
            android:layout_marginEnd="@dimen/writing_toolkit_summary_translate_arrow_icon_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/translate_arrow"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/WritingToolkitTranslateDropdownSelectedStyle"/>
        <ImageView
            android:id="@+id/translate_arrow"
            android:layout_width="@dimen/writing_toolkit_summary_translate_arrow_icon_size"
            android:layout_height="@dimen/writing_toolkit_summary_translate_arrow_icon_size"
            android:src="@drawable/writing_toolkit_summary_translate_oneway"
            android:tint="@color/writing_toolkit_summary_translate_arrow_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/target_language"
            app:layout_constraintStart_toEndOf="@+id/source_language"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:gravity="center"
            android:id="@+id/target_language"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/writing_toolkit_summary_translate_arrow_icon_margin_horizontal"
            android:layout_marginEnd="@dimen/writing_toolkit_summary_translate_spinner_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/translate_arrow"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/WritingToolkitTranslateLanguageSpinnerStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/writing_toolkit_translate_divider"
        android:tag="binding_2"
        android:background="@color/writing_toolkit_item_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/writing_toolkit_summary_translate_divider_height"
        android:layout_marginBottom="@dimen/writing_toolkit_summary_translate_divider_bottom_margin"
        android:layout_marginHorizontal="@dimen/writing_toolkit_summary_translate_divider_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/writing_toolkit_translate_language"/>
    <TextView
        android:textSize="@dimen/writing_toolkit_result_item_subtitle_text_size"
        android:textColor="@color/writing_toolkit_result_item_sub_title_text_color"
        android:gravity="start"
        android:id="@+id/writing_toolkit_result_sub_title"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/writing_toolkit_result_item_subtitle_text_margin_top"
        android:fontFamily="sec"
        android:layout_marginHorizontal="@dimen/writing_toolkit_result_item_container_padding_horizontal"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/writing_toolkit_translate_divider"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarThumbVertical="@drawable/writing_toolkit_scrollbar"
        android:id="@+id/writing_toolkit_result_nested_scroll_view"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/writing_toolkit_result_action_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/writing_toolkit_result_sub_title"
        app:layout_goneMarginTop="@dimen/writing_toolkit_result_item_text_gone_margin_top">
        <TextView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/writing_toolkit_result_text"
            android:tag="binding_4"
            android:background="@null"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/writing_toolkit_result_item_text_margin_top"
            android:nestedScrollingEnabled="true"
            android:paddingHorizontal="@dimen/writing_toolkit_result_item_container_padding_horizontal"
            style="@style/WritingToolkitResultItemTextStyle"/>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/writing_toolkit_result_action_layout"
        layout="@layout/writing_toolkit_result_action_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
