<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/writing_toolkit_main_item"
    android:tag="layout/writing_toolkit_top_icon_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stateListAnimator="?attr/seslSmallTouchAnimator"
    android:paddingHorizontal="@dimen/writing_toolkit_top_icon_item_margin_horizontal">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/writing_toolkit_main_icon"
        android:tag="binding_1"
        android:layout_width="@dimen/writing_toolkit_icon_size"
        android:layout_height="@dimen/writing_toolkit_icon_size"
        android:layout_marginBottom="@dimen/writing_toolkit_top_icon_item_gap"
        android:tint="@color/writing_toolkit_item_icon_color"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/writing_toolkit_main_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="top|center_horizontal"
        android:id="@+id/writing_toolkit_main_text"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:textAlignment="gravity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/writing_toolkit_main_icon"
        style="@style/WritingToolkitItemTextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
