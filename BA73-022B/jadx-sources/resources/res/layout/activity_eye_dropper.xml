<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/eyedropperFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/screenshotView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.picker.eyeDropper.SeslMagnifyingView
        android:layout_gravity="center"
        android:id="@+id/magnifierView"
        android:visibility="gone"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="@dimen/sesl_eyedropper_y_animation_offset"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/pointerView"
        android:background="@drawable/sesl_eyedropper_pointer"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginBottom="@dimen/sesl_eyedropper_y_animation_offset"/>
</FrameLayout>
